---
import { site } from '../site.config.mjs';

// STARTER PLACEHOLDER: functional, deliberately plain. Redesign it for the
// concept before anyone sees the site (qa.mjs fails while it is unchanged).
// Keep: the nav list, aria-current, a tap-to-call action, keyboard access.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const tel = site.phoneHref || site.phone.replace(/[^\d+]/g, '');
---
<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">{site.name}</a>
    {site.phone && (
      <a href={`tel:${tel}`} class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-ink sm:order-3">Call us</a>
    )}
    <nav aria-label="Main" class="w-full sm:order-2 sm:w-auto">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[15px]">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
              class="inline-block py-1 underline-offset-4 hover:underline aria-[current=page]:font-semibold"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
