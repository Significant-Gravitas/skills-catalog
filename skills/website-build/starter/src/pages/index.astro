---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.mjs';
// Starter page. Replace every REPLACE marker with real, owner-approved copy;
// qa.mjs fails the build check while any marker is left.
---
<Base title={site.name} description="REPLACE: one sentence, under 155 characters, saying what the business does and where.">
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-6xl">REPLACE: the promise, in the customer's words</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">REPLACE: who it is for, what they get, and why this business.</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/contact/" class="rounded-md bg-accent px-6 py-3 font-medium text-accent-ink hover:opacity-90">REPLACE: primary action</a>
    </div>
  </section>
</Base>
