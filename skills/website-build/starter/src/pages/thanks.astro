---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks" description="Your message has been sent." noindex>
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <h1 class="font-display text-3xl font-semibold tracking-tight">Thanks, your message is on its way.</h1>
    <p class="mt-4 text-muted">We will get back to you soon.</p>
    <p class="mt-8"><a class="underline" href="/">Back to the home page</a></p>
  </section>
</Base>
