---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.mjs';
import { forms } from '../forms.config.mjs';
const tel = site.phoneHref || site.phone.replace(/[^\d+]/g, '');
---
<Base title="Contact" description={`Contact ${site.name}: call, email or send a message and we will get back to you.`}>
  <section class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Contact</h1>
    <div class="mt-6 space-y-2 text-lg">
      {site.phone && <p>Call <a class="underline" href={`tel:${tel}`}>{site.phone}</a></p>}
      {site.email && <p>Email <a class="underline" href={`mailto:${site.email}`}>{site.email}</a></p>}
      {site.hoursText.length > 0 && <p class="text-base text-muted">{site.hoursText.join(' · ')}</p>}
    </div>
    {forms.web3formsKey ? (
      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="mt-10 grid gap-5">
        <input type="hidden" name="access_key" value={forms.web3formsKey} />
        <input type="hidden" name="subject" value={`New enquiry from the ${site.name} website`} />
        <input type="hidden" name="from_name" value={`${site.name} website`} />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
        <label class="grid gap-1">
          <span class="font-medium">Name</span>
          <input name="name" required autocomplete="name" class="rounded-md border border-line px-3 py-3" />
        </label>
        <label class="grid gap-1">
          <span class="font-medium">Email</span>
          <input name="email" type="email" required autocomplete="email" class="rounded-md border border-line px-3 py-3" />
        </label>
        <label class="grid gap-1">
          <span class="font-medium">Phone (optional)</span>
          <input name="phone" type="tel" autocomplete="tel" class="rounded-md border border-line px-3 py-3" />
        </label>
        <label class="grid gap-1">
          <span class="font-medium">Message</span>
          <textarea name="message" rows="5" required class="rounded-md border border-line px-3 py-3"></textarea>
        </label>
        <p class="text-sm text-muted">We use your details only to reply. See our <a class="underline" href="/privacy/">privacy notice</a>.</p>
        <button type="submit" class="justify-self-start rounded-md bg-accent px-6 py-3 font-medium text-accent-ink hover:opacity-90">Send message</button>
        <p id="form-status" role="status" class="text-sm"></p>
      </form>
    ) : null}
  </section>
  {forms.web3formsKey && (
    <script is:inline>
      // Sends the form without leaving the site, then shows /thanks/. Without
      // JavaScript the form still posts to Web3Forms and shows their thank-you page.
      const form = document.getElementById('contact-form');
      const status = document.getElementById('form-status');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const button = form.querySelector('button[type=submit]');
        button.disabled = true;
        status.textContent = 'Sending...';
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          const data = await res.json();
          if (data.success) { window.location.href = '/thanks/'; return; }
          status.textContent = 'Sorry, that did not send. Please call or email us instead.';
        } catch {
          status.textContent = 'Sorry, that did not send. Please call or email us instead.';
        }
        button.disabled = false;
      });
    </script>
  )}
</Base>
