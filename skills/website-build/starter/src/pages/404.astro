---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found." noindex>
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <h1 class="font-display text-3xl font-semibold tracking-tight">We couldn't find that page.</h1>
    <p class="mt-4 text-muted">It may have moved. Try the home page instead.</p>
    <p class="mt-8"><a class="rounded-md bg-accent px-6 py-3 font-medium text-accent-ink" href="/">Go to the home page</a></p>
  </section>
</Base>
