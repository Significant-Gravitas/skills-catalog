[{"sha":"56202d1c47f7ccd5d96fac6ae65fc6fda7c27180","node_id":"C_kwDOQ6n2J9oAKDU2MjAyZDFjNDdmN2NjZDVkOTZmYWM2YWU2NWZjNmZkYTdjMjcxODA","commit":{"author":{"name":"Corey Haines","email":"34802794+coreyhaines31@users.noreply.github.com","date":"2026-08-23T21:24:00Z"},"committer":{"name":"Corey Haines","email":"34802794+coreyhaines31@users.noreply.github.com","date":"2026-08-23T21:24:00Z"},"message":"feat: add primary-research layer to customer-research\n\nThe skill was mining/online-sleuthing heavy and thin on primary\nresearch. Add an interviews + surveys layer so agents can help users\ngo ask customers directly, not just observe them in public.\n\nNew references/interviews-and-surveys.md covers the Sean Ellis /\nSuperhuman PMF survey (the \"no longer use\" question plus the 40% \"very\ndisappointed\" benchmark, Superhuman's 58%), Keep-Asking-Why 5-why\nladdering with a churn-to-NRR worked example, a best-customers CRM\nrecruiting method, incentive guidance ($50/call, $5/survey; aim 10,\nhappy with 5), an outreach email template, Amy Hoy's Sales Safari,\nand the confirmation-bias guardrail (prove yourself wrong; Dropbox).\nAdapted from Founding Marketing ch.2.\n\nSKILL.md gains a Mode 3 (primary research) that routes to the new\nreference; description adds primary-research triggers; new eval id 13.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"f21a08ea6babe56e2b234f28b641d759b54cbba7","url":"https://api.github.com/repos/coreyhaines31/marketingskills/git/trees/f21a08ea6babe56e2b234f28b641d759b54cbba7"},"url":"https://api.github.com/repos/coreyhaines31/marketingskills/git/commits/56202d1c47f7ccd5d96fac6ae65fc6fda7c27180","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/coreyhaines31/marketingskills/commits/56202d1c47f7ccd5d96fac6ae65fc6fda7c27180","html_url":"https://github.com/coreyhaines31/marketingskills/commit/56202d